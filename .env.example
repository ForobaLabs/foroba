# Foroba — environment variables
# Copy to .env and fill in values

# Backend API URLs
VITE_PAZURU_API_URL=http://localhost:8001
VITE_TSUMI_API_URL=http://localhost:8000
VITE_JELI_API_URL=http://localhost:8002

# Deployment mode: selfhost | hosted — mirrors backend's DEPLOYMENT_MODE (GL-4.3).
# selfhost shows dev-oriented "start the service locally" copy; hosted shows a
# generic unavailable message since end users don't run the backend themselves.
VITE_DEPLOYMENT_MODE=selfhost

# GitLab PAT for @foroba/ui package registry (pnpm install)
FOROBA_UI_TOKEN=glpat-...
