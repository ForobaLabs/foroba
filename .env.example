# Foroba — environment variables
# Copy to .env and fill in values

# Backend API URLs
VITE_PAZURU_API_URL=http://localhost:8001
VITE_TSUMI_API_URL=http://localhost:8000
VITE_JELI_API_URL=http://localhost:8002

# Deployment mode: selfhost | hosted — mirrors backend's DEPLOYMENT_MODE (GL-4.3).
# selfhost shows dev-oriented "start the service locally" copy; hosted shows a
# generic unavailable message since end users don't run the backend themselves.
VITE_DEPLOYMENT_MODE=selfhost

# Public browser-facing origins for Pazuru/Tsumi, read by the BACKEND (config.py,
# no VITE_ prefix) to build cross-app session handoff redirect targets (Plan U,
# pazuru#150). Distinct from PAZURU_API_URL/TSUMI_API_URL, which are internal
# Docker-network URLs for server-to-server calls and are not set here in dev
# (localhost defaults in config.py already match dev.sh's ports).
PAZURU_APP_URL=http://localhost:5173
TSUMI_APP_URL=http://localhost:5178

