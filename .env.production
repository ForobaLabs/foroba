# Foroba — production environment template
# Copy to .env.production.local and fill in. Never commit secrets.

# API base URLs (rewritten by nginx proxy in Docker — keep as /prefix)
VITE_PAZURU_API_URL=/pazuru-api
VITE_TSUMI_API_URL=/tsumi-api
VITE_JELI_API_URL=/jeli

# App version (injected at build time via package.json)
# VITE_APP_VERSION is set automatically by vite.config.ts
