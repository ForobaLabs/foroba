OLLAMA_BASE_URL=http://localhost:11434
# qwen2.5:3b-instruct <- DEFAULT (2026-09-25, Plan W). Must match Pazuru's
# OLLAMA_LLM_MODEL: the shared VPS Ollama instance has OLLAMA_MAX_LOADED_MODELS=1,
# so a mismatched pair forces a reload on every cross-app request. Chosen against
# the real production workload (tool-calling + 3-way concurrent load), not raw
# tok/s -- see pazuru/ARCHITECTURE_DECISIONS.md ADR-002 for the full benchmark
# table. The prior default, phi3.5:latest, crashed the whole Ollama process under
# load. Local dev on a machine with more headroom can override with a larger
# model (e.g. qwen3.5:9b) -- don't deploy a mismatched model to the shared VPS.
OLLAMA_MODEL=qwen2.5:3b-instruct
PAZURU_API_URL=http://localhost:8001
TSUMI_API_URL=http://localhost:8050
# Shared secret sent as X-Internal-Token to Pazuru/Tsumi internal endpoints; must equal their INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=
JELI_PORT=8002

# Auth (SP9 / C1, RS256 migration foroba#149)
# Foroba generates+persists its own RSA keypair on first startup — no secret to set here.
# Override these two only if you want the keys stored somewhere other than ./keys/.
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_TTL_MINUTES=60
COOKIE_SECURE=false
# In Docker, this MUST be an absolute path under the /data volume mount, or the
# database silently lives in the container's writable layer and is wiped on the
# next image rebuild. Local (non-Docker) dev can keep a relative filename.
AUTH_DB_PATH=/data/foroba_identity.db
SEED_MOCK_USERS=true

# Entitlements (SP10a / C3)
PREMIUM_GATING_ENABLED=true

# Onboarding MiFID test (SP10b / C4) — built but disabled by default
ONBOARDING_MIFID_ENABLED=false

# Security (SP18)
ALLOWED_ORIGINS=http://localhost:5175
RATE_LIMIT_DEFAULT=60/minute

# Error tracking (TI-B item 2, foroba#153) — self-hosted GlitchTip DSN.
# Empty by default: the sentry-sdk client no-ops entirely when unset.
GLITCHTIP_DSN=

# Offsite backup (TI-E, foroba#172) — daily automatic upload of the encrypted
# suite backup to Cloudflare R2. All empty by default: the scheduler runs, sees
# the feature unconfigured, logs and exits — zero behavior change until filled in.
# Setup: Cloudflare dashboard > R2 > create bucket > Manage API Tokens (scope to
# that bucket only). BACKUP_ENCRYPTION_PASSPHRASE must be a long random secret —
# losing it makes existing offsite backups unrecoverable; store it outside this repo.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BACKUP_ENCRYPTION_PASSPHRASE=

# Field-level encryption at rest (GL-11.3, foroba#192) — encrypts Jeli Lab chat
# history (sandbox_conversations.content/code). Must be a urlsafe-base64 32-byte
# key. Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Whole-file DB encryption at rest (GL-11.2, foroba#195) — SQLCipher passphrase
# for the entire foroba_identity.db file. SEPARATE key from FIELD_ENCRYPTION_KEY
# above: that one is per-column Fernet (different trust boundary), this one
# encrypts the whole SQLite file via sqlcipher3. Empty = unencrypted (dev
# default). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
DB_ENCRYPTION_KEY=

# Paddle Billing server API key (USER provides at go-live; never commit a real value)
PADDLE_API_KEY=
PADDLE_API_BASE=https://sandbox-api.paddle.com

# Breach-runbook kill switch: true blocks sign-in endpoints with 503
MAINTENANCE_MODE=false

# Public site origin for waitlist confirm redirects (Plan D). Also append it to ALLOWED_ORIGINS.
SITE_BASE_URL=
# Public origin serving /api/public/v1/waitlist; the waitlist confirmation link is built
# from it (never from the Host header). Leave empty to disable confirmation e-mails.
API_PUBLIC_BASE_URL=
