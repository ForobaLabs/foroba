OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
PAZURU_API_URL=http://localhost:8001
TSUMI_API_URL=http://localhost:8050
JELI_PORT=8002

# Auth (SP9 / C1, RS256 migration foroba#149)
# Foroba generates+persists its own RSA keypair on first startup — no secret to set here.
# Override these two only if you want the keys stored somewhere other than ./keys/.
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
JWT_TTL_MINUTES=60
COOKIE_SECURE=false
AUTH_DB_PATH=foroba_identity.db
SEED_MOCK_USERS=true

# Entitlements (SP10a / C3)
PREMIUM_GATING_ENABLED=true

# Onboarding MiFID test (SP10b / C4) — built but disabled by default
ONBOARDING_MIFID_ENABLED=false

# Security (SP18)
ALLOWED_ORIGINS=http://localhost:5175
RATE_LIMIT_DEFAULT=60/minute

# Error tracking (TI-B item 2, foroba#153) — self-hosted GlitchTip DSN.
# Empty by default: the sentry-sdk client no-ops entirely when unset.
GLITCHTIP_DSN=
